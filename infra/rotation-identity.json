{
  "name": "rotate-credentials",
  "environment": "rotate-credentials",
  "repository": "UstDoesTech/OpenLedgerKernel",
  "aws": {
    "sign": [
      "kms:GetPublicKey",
      "kms:Sign"
    ],
    "secrets": [
      "secretsmanager:GetSecretValue",
      "secretsmanager:ListSecretVersionIds",
      "secretsmanager:PutSecretValue"
    ],
    "administrator_secret": [
      "secretsmanager:GetSecretValue",
      "secretsmanager:ListSecretVersionIds"
    ],
    "node_secrets": [
      "secretsmanager:PutSecretValue"
    ],
    "member_secrets": [
      "secretsmanager:PutSecretValue"
    ],
    "encryption": [
      "kms:Decrypt",
      "kms:GenerateDataKey"
    ],
    "member_encryption": [
      "kms:Decrypt",
      "kms:GenerateDataKey"
    ],
    "state_encryption": [
      "kms:Decrypt"
    ],
    "plan_store_encryption": [
      "kms:GenerateDataKey"
    ],
    "state": [
      "s3:GetObject"
    ],
    "state_bucket": [
      "s3:ListBucket"
    ],
    "plan_store": [
      "s3:PutObject"
    ],
    "max_session_seconds": 7200
  },
  "azure": {
    "vault_roles": [
      "Key Vault Contributor",
      "Key Vault Secrets Officer"
    ],
    "administrator_vault_roles": [
      "Key Vault Contributor",
      "Key Vault Secrets User"
    ]
  },
  "gcp": {
    "secret_roles": [
      "roles/secretmanager.secretAccessor",
      "roles/secretmanager.secretVersionAdder",
      "roles/secretmanager.viewer"
    ],
    "administrator_secret_roles": [
      "roles/secretmanager.secretAccessor",
      "roles/secretmanager.viewer"
    ],
    "node_secret_roles": [
      "roles/secretmanager.secretVersionAdder"
    ],
    "member_secret_roles": [
      "roles/secretmanager.secretVersionAdder"
    ]
  }
}
